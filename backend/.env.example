# Copy this file to .env and fill in your own IBM watsonx credentials.
# Get them from https://cloud.ibm.com  →  watsonx.ai project settings.

IBM_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional
# DATABASE_URL=postgresql://user:pass@localhost:5432/vendoriq
