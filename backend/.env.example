# backend/.env.example — copy to backend/.env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────
# Supabase PostgreSQL (asyncpg driver), e.g.
# postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres?ssl=require
DATABASE_URL=
GROQ_API_KEY=

# ── Optional ─────────────────────────────────────────────
# TLS to Postgres: "require" (default; Supabase) or "disable" (the local
# docker-compose Postgres, which docker-compose.yml sets for you)
DATABASE_SSL=require

# Redis cert cache; falls back to Supabase-only if unreachable.
# docker-compose overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379

# ChromaDB directory for RAG
CHROMA_PATH=./chroma_db

# Logging: LOG_LEVEL = DEBUG | INFO | WARNING | ERROR (default INFO);
# LOG_FORMAT = json (default, one JSON object per line) | console
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agents' scoring call: true = JSON-schema structured output (default),
# false = plain-text call parsed by regex (for eval comparisons)
AGENT_STRUCTURED_OUTPUT=true

# Comma-separated browser origins allowed to call the API.
# Default when unset: http://localhost:5173 (Vite dev server / docker frontend)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ISO date/datetime; Supabase cert_cache rows cached before this are
# treated as expired. Set to the deploy date when cert discovery changes
# and the cache can't be purged. Unset = no cutoff.
CERT_CACHE_VALID_AFTER=

# CSA STAR live registry API (only used if the connector's seed-dataset DEMO_MODE is off)
CSA_STAR_API_KEY=

# FAIR agent: quantifies the vendor's loss exposure in dollars after the five
# agents run (adds ~15K Groq tokens per evaluation; skipped when a hard rule
# such as an OFAC match already rejects the vendor).
FAIR_ENABLED=true
# Pace calls to this many tokens/minute (Groq free tier: 8000). 0 = no pacing.
FAIR_TOKENS_PER_MINUTE=8000
# gpt-oss reasoning effort: low (default, fewer tokens) | medium | high
FAIR_REASONING_EFFORT=low
# Give up and use the benchmark baseline after this many seconds
FAIR_MAX_SECONDS=300

# Public hosting (see docs/deploy.md). Each live evaluation spends ~30-45K
# Groq tokens. Both unset = anyone may run evaluations (fine locally).
# Demo mode: set a passcode and leave the limit at 0; visitors see saved
# reports and only people with the passcode can start a run.
EVALUATE_PASSCODE=
# Let anyone start this many evaluations per rolling 24 hours (0 = none
# without the passcode when a passcode is set, unlimited when it is not).
EVALUATE_DAILY_LIMIT=0
